name: Build Speak to Calsi APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extract Android project
        run: |
          unzip -q SpeakToCalsi_Android_Project.zip -d buildsrc

      - name: Build APK
        working-directory: buildsrc/SpeakToCalsi_Android
        run: gradle --no-daemon assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Speak-to-Calsi-APK
          path: buildsrc/SpeakToCalsi_Android/app/build/outputs/apk/debug/app-debug.apk
